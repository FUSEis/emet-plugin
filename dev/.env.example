# Copy to dev/.env, which git ignores, and fill in.

# Claude Code sign-in. Uncomment one, or leave both out and run /login in the session.
# A token from `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=
# Or an API key from the Claude Console:
# ANTHROPIC_API_KEY=

# From the Emet on this machine: Applications, then Manage keys
CLAUDE_PLUGIN_OPTION_EMET_KEY=
# The External ID of a team, from Teams
CLAUDE_PLUGIN_OPTION_TENANT_REF=
# The email of your account in the local Emet. Needed when you sign in with a token or API key above;
# with /login the plugin takes it from the Claude sign-in
# CLAUDE_PLUGIN_OPTION_EMET_EMAIL=

# The port the local Emet listens on
EMET_PORT=8000
